generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model connections {
  id              String  @id @db.VarChar(5)
  user_accepted   Boolean @default(false)
  device_accepted Boolean @default(false)

  // Relations
  user_id   String @db.VarChar(5)
  device_id String @db.VarChar(5)

  devices devices @relation(fields: [device_id], references: [id], onDelete: Cascade, map: "fk_device")
  users   users   @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_user")

  ai_chat_history ai_chat_history[]

  @@unique([user_id, device_id])
}

model devices {
  id           String    @id @db.VarChar(5)
  created_at   DateTime  @default(now()) @db.Timestamp(6)
  access_token String?   @unique @db.VarChar(20)
  device_name  String    @db.VarChar(20)
  description  String?   @db.VarChar(80)
  status       Boolean   @default(false)
  last_online  DateTime?

  // Relations
  connections connections[]
  ai_reports  ai_reports[]
}

model users {
  id                  String    @unique @db.VarChar(5)
  username            String?   @unique @db.VarChar(35)
  password            String?   @db.VarChar(70)
  email               String    @unique @db.VarChar(50)
  verification_token  String?   @db.VarChar(5)
  access_token        String?   @unique @db.VarChar(20)
  access_token_expire DateTime? @db.Timestamp(6)
  created_at          DateTime  @default(now()) @db.Timestamp(6)

  // Relations
  connections connections[]
}

model ai_reports {
  id          String   @unique @db.VarChar(10)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  title       String   @db.VarChar(50)
  suggestions String   @db.VarChar(300)
  fact        String   @db.VarChar(300)

  // Relations
  device_id String  @db.VarChar(5)
  devices   devices @relation(fields: [device_id], references: [id], onDelete: Cascade, map: "fk_device")
}

model ai_chat_history {
  id         String   @unique @db.VarChar(10)
  created_at DateTime @default(now()) @db.Timestamp(6)
  from_user  Boolean
  message    String   @db.VarChar(500)

  // Relations
  connection_id String      @db.VarChar(5)
  connections   connections @relation(fields: [connection_id], references: [id], onDelete: Cascade, map: "fk_connection")
}
