---
import ContentController from "./contents/content_controller";
import ConnectDeviceModal from "./modal/add_device";
import LoginRequired from "../global/login_required";
import DashboardSidebar from "./sidebar/dashboard_sidebar.astro";
import DashboardNavbar from "./navbar/dashboard_navbar.astro";


---

<LoginRequired client:only />
<ConnectDeviceModal client:load />

<div class="absolute top-0 left-0 w-dvw h-dvh flex flex-col md:flex-row">
  <DashboardSidebar />
  <DashboardNavbar />

  <div class="w-full h-full">
    <ContentController client:load />
  </div>
</div>