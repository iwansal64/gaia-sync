---
import DashboardSidebarButtons from "./dashboard_sidebar_button";
import DashboardSidebarClose from "./dashboard_sidebar_close";
import DashboardNavbarTrigger from "./dashboard_sidebar_trigger";

---

<nav class="duration-500 fixed md:relative w-full md:w-fit h-full z-100 -translate-y-full has-[.active]:translate-y-[unset] md:translate-y-[unset] flex flex-col bg-gray-600 gap-8">
      <DashboardNavbarTrigger client:load />
      <DashboardSidebarClose client:load />
      <div class="flex flex-col mt-6 px-8 box-border gap-8">
            <div>
                  <h1 class="font-bold text-white text-2xl">GAIA</h1>
                  <h1 class="font-thin text-white text-sm">Green Aquaponics Intelligent Assistance</h1>
            </div>
            <button class="px-2 py-4 rounded-full w-full h-full bg-[#5c0] text-white font-bold cursor-pointer hover:brightness-110">Get Insight Today!</button>
      </div>
      <DashboardSidebarButtons client:load />
      <div class="h-full flex flex-col justify-end">
            <a class="w-full p-4 bg-gray-500 text-white cursor-pointer hover:brightness-110" href="/gate/logout">Logout</a>
      </div>
</nav>
